# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# From your Kite Connect developer app (developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=

# Generated daily by scripts/kite_login.py -- expires each day
# (Kite sessions invalidate around the next trading day). Do not
# hand-edit; re-run the login script each morning before use.
KITE_ACCESS_TOKEN=
