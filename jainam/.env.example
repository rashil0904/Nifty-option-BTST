# Copy this file to jainam/.env and fill in real values.
# jainam/.env is gitignored -- never commit real credentials.

# Jainam's own API host, from their API dashboard -- NOT
# developers.symphonyfintech.in, which is Symphony's own dev sandbox.
JAINAM_BASE_URL=

# XTS Market Data API credentials (quotes, candles, instrument lookup).
JAINAM_MARKET_API_KEY=
JAINAM_MARKET_API_SECRET=

# XTS Interactive API credentials (positions, orders).
JAINAM_INTERACTIVE_API_KEY=
JAINAM_INTERACTIVE_API_SECRET=

# Usually "WEBAPI" -- leave unset unless Jainam tells you otherwise.
JAINAM_SOURCE=WEBAPI

JAINAM_CLIENT_ID=
JAINAM_LIVE=false

# Telegram alerts for live entry/exit (see notify.py). Create a bot via
# @BotFather, message it once, then GET
# https://api.telegram.org/bot<token>/getUpdates to read the chat id
# back out.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
